# nanolx-apt(1) completion                                  -*- shell-script -*-

_comp_cmd_nanolx_apt() {
    local cur prev opts
    COMPREPLY=()

    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"
    opts="list add remove check enable-config disable-config enable-pinning disable-pinning help"

    case "${prev}" in
        add|remove)
            local repositories="debian nanolx liquorix i2p winehq debmultimedia mozillavpn"
            COMPREPLY=( $(compgen -W "${repositories}" -- "${cur}") )
            return 0
        ;;

        *)
        ;;
    esac

    COMPREPLY=( $(compgen -W "${opts}" -- "${cur}") )
    return 0
}

complete -F _comp_cmd_nanolx_apt nanolx-apt