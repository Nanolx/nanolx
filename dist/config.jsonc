{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "chafa",
        "chafa": {
            "fgOnly": true,
            "symbols": "ascii"
        },
        "source": "/usr/share/cockpit/branding/nanolx/logo-large.png",
        "width": 40,
        "height": 20,
        "padding": {
            "top": 5
        }
    },
    "modules": [
        "title",
        "separator",
        "os",
        "host",
        "bootmgr",
        "kernel",
        "uptime",
        "packages",
        "shell",
        "display",
        "de",
        "wm",
        "wmtheme",
        "theme",
        "icons",
        "font",
        "cursor",
        "terminal",
        "cpu",
        "gpu",
        "memory",
        "disk",
        "break",
        "colors"
    ]
}

