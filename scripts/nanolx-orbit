#!/bin/bash

version="0.0.9"
reldate="2026/08/01"

# version management in /usr/share for more flexibility
echo "loading configuration (takes a few seconds because of Citrix)"
if [ -f nanolx-orbit.conf ]; then
    source nanolx-orbit.conf
else
    source /usr/share/nanolx/nanolx-orbit.conf
fi

pkg_base="/var/cache/nanolx"
mkdir -p "${pkg_base}"

curl_opts="-L --progress-bar -C -"

download_package () {
    url="${1}"
    pkg="${2}"
    sha="${3}"
    out="${pkg_base}/${4}"

    if [ -f "${out}" ]; then
        echo -e "\nPackage ${pkg} (${out##*/}) already downloaded, verifying"
        if ! echo "${sha}" "${out}" | sha256sum -c &>/dev/null; then
            echo "SHA256 checksum for ${out} is wrong"
            rm "${out}"
            noinst=true
        else
            echo "SHA256 checksum for ${out} is correct"
        fi
    else
        echo -e "\nDownloading ${pkg}: (${out})"
        curl ${curl_opts} -o "${out}" "${url}"
        if ! echo "${sha}" "${out}" | sha256sum -c &>/dev/null; then
            echo "SHA256 checksum for ${out} is wrong"
            rm "${out}"
            noinst=true
        else
            echo "SHA256 checksum for ${out} is correct"
        fi
    fi

}

install_package () {
    pkg="${pkg_base}/${1}"

    if [[ "${mode}" = "in" ]]; then
        if [[ "${noinst}" = "false" ]]; then
            gdebi -nq "${pkg}"
        else
            echo "not installing ${pkg} due to wrong SHA256 checksum"
        fi
    fi
}

install_helper () {
    local name="${1}"

    local -n url="${name/-/_}_url"
    local -n sha="${name/-/_}_sha"
    local filename="${url##*/}"

    download_package "${url}" "${name}" "${sha}" "${filename}"
    install_package "${filename}"
}


handle_packages () {
    mode="${1}"
    shift

    for pkg in "${@}"; do
        noinst=false
        case ${pkg} in
            discord | pixes | zoom-vdi | openrgb-effects | openrgb-hwsync | openrgb-fansync | ulauncher | appimagelauncher )
                install_helper "${pkg}"
            ;;
            zoom )
                download_package "${zoom_url}" zoom "${zoom_sha}" "zoom_${zoom_ver}.deb"
                install_package "zoom_${zoom_ver}.deb"
            ;;
            citrix )
                download_package "${citrix_url}" citrix "${citrix_sha}" "${citrix_pkg}"
                install_package "${citrix_pkg}"
            ;;
            citrix-usb )
                download_package "${citrix_usb_url}" citrix-usb "${citrix_usb_sha}" "${citrix_usb_pkg}"
                install_package "${citrix_usb_pkg}"
            ;;
            citrix-epa )
                download_package "${citrix_epa_url}" citrix-epa "${citrix_epa_sha}" "${citrix_epa_pkg}"
                install_package "${citrix_epa_pkg}"
            ;;
            citrix-beta )
                download_package "${citrix_beta_url}" citrix-beta "${citrix_beta_sha}" "${citrix_beta_pkg}"
                install_package "${citrix_beta_pkg}"
            ;;
            citrix-beta-usb )
                download_package "${citrix_beta_usb_url}" citrix-beta-usb "${citrix_beta_usb_sha}" "${citrix_beta_usb_pkg}"
                install_package "${citrix_beta_usb_pkg}"
            ;;
            * )
                echo "package ${pkg} unknown"
            ;;
        esac
    done
}

user_opt="${1}"
shift

case ${user_opt} in
    download )
        if [[ -z "${@}" ]]; then
            echo "no packages specified, exit."
            exit 0
        else
            handle_packages dl "${@}"
        fi
    ;;

    install )
        if [[ -z "${@}" ]]; then
            echo "no packages specified, exit."
            exit 0
        else
            handle_packages in "${@}"
        fi
    ;;

    list )
        echo "nanolx-orbit supports the following packages: ${package_list}"
    ;;

    clear )
        echo "removing downloaded packages from ${pkg_base}"
        rm -fv "${pkg_base}"/*
    ;;

    help | * )
        echo -e "nanolx-orbit v${version} (${reldate})
© 2026 Christopher Roy Bratusek <nano@jpberlin.de>

licensed under the GNU General Public License v3 (or newer)

usage:
    nanolx-orbit list
    nanolx-orbit download
    nanolx-orbit install
    nanolx-orbit clear
"
    ;;
esac
