#!/bin/bash

version="0.2.1"
reldate="2026/09/14"

if (( EUID != 0 )); then
    echo "${scriptname} must be run as root"
    exit 1
fi

scriptname=$(basename ${0})

pkg_base="/var/cache/nanolx"
mkdir -p "${pkg_base}"

source /usr/share/nanolx/${scriptname}.conf

curl_opts="-L --progress-bar -C -"

download_package () {
    url="${1}"
    pkg="${2}"
    sha="${3}"

    if [ -z "${5}" ]; then
        out="${pkg_base}/${4}"
    else
        out="${pkg_base}/${5}"
    fi

    if [ -f "${out}" ]; then
        echo -e "\nPackage ${pkg} (${out##*/}) already downloaded, verifying"
        if ! echo "${sha}" "${out}" | sha256sum -c &>/dev/null; then
            echo "SHA256 checksum for ${out} is wrong"
            rm "${out}"
            noinst=true
        else
            echo "SHA256 checksum for ${out} is correct"
        fi
    else
        echo -e "\nDownloading ${pkg}: (${out})"
        case "${out}" in
            *.zip )
                curl ${curl_opts} "${url}" | bsdtar -xf- -C "${pkg_base}/"
            ;;
            * )
                curl ${curl_opts} -o "${out}" "${url}"
            ;;
        esac
        if ! echo "${sha}" "${out}" | sha256sum -c &>/dev/null; then
            echo "SHA256 checksum for ${out} is wrong"
            rm "${out}"
            noinst=true
        else
            echo "SHA256 checksum for ${out} is correct"
        fi
    fi

}

install_package () {
    pkg="${pkg_base}/${1}"

    if [[ "${mode}" = "in" ]]; then
        if [[ "${noinst}" = "false" ]]; then
            gdebi -nq "${pkg}"
        else
            echo "not installing ${pkg} due to wrong SHA256 checksum"
        fi
    fi
}

install_helper () {
    local name="${1}"

    local -n url="${name//-/_}_url"
    local -n sha="${name//-/_}_sha"
    if [ -z "${2}" ]; then
        local filename="${url##*/}"
    else
        local -n filename="${name//-/_}_pkg"
    fi
    local -n unzip_filename="${name//-/_}_pkg2"

    download_package "${url}" "${name}" "${sha}" "${filename}" "${unzip_filename}"
    if [ -z "${unzip_filename}" ]; then
        install_package "${filename}"
    else
        install_package "${unzip_filename}"
    fi
}


handle_packages () {
    mode="${1}"
    shift

    for pkg in "${@}"; do
        noinst=false
        case ${pkg} in
            zoom-vdi )
                install_helper "${pkg}"
            ;;
            zoom | citrix | citrix-usb | citrix-epa | citrix-beta | citrix-beta-usb | webex-vdi )
                install_helper "${pkg}" true
            ;;
            * )
                echo "package ${pkg} unknown"
            ;;
        esac
    done
}

user_opt="${1}"
shift

case ${user_opt} in
    download )
        if [[ -z "${@}" ]]; then
            echo "no packages specified, exit."
            exit 0
        else
            handle_packages dl "${@}"
        fi
    ;;

    install )
        if [[ -z "${@}" ]]; then
            echo "no packages specified, exit."
            exit 0
        else
            handle_packages in "${@}"
        fi
    ;;

    list )
        echo "${scriptname} supports the following packages: ${package_list}"
    ;;

    clear )
        echo "removing downloaded packages from ${pkg_base}"
        rm -fv "${pkg_base}"/*
    ;;

    version)
        echo "${scriptname} ${version} (${reldate})"
    ;;

    help | * )
        echo -e "${scriptname} v${version} (${reldate})
© 2026 Christopher Roy Bratusek <nano@jpberlin.de>

licensed under the GNU General Public License v3 (or newer)

usage:
    ${scriptname} list           list available packages
    ${scriptname} download       only download desired package
    ${scriptname} install        download and install desired package
    ${scriptname} clear          clear temporary download directory
    ${scriptname} version        print version
"
    ;;
esac
