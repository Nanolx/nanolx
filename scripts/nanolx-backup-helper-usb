#!/bin/bash
scriptname=$(basename ${0})

SOURCE="${1}"
UUID="${2}"
BLKD=$(blkid -U ${UUID})
MOUNT="/media/${UUID}"
LOGFILE="/var/log/${scriptname}-${UUID}-$(date '+%Y%m%d_%H%M%S').log"

_USER=$(loginctl list-sessions --no-legend | awk '/user /{print $3}' | head -n1)
[ -z "${_USER}" ] && _USER=$(who | awk '{print $1}' | head -n1)
_UID=$(id -u "${_USER}")

echo $_USER $_UID

send_notification () {
    local title="${1}"
    local message="${2}"
    local icon="${3}"

    if [ -n "${_USER}" ] && [ -d "/run/user/${_UID}" ]; then
        sudo -u "${_USER}" \
          DISPLAY=:0 \
          DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/${_UID}/bus \
          PATH=/usr/bin:${PATH} \
          XDG_DATA_DIRS="/usr/share/${XDG_CURRENT_DESKTOP}:/usr/share" \
          notify-send -t 20000 -i "${icon}" "${title}" "${message}"
    fi
}

zenity_ask_pass () {
    PASS=$(sudo -u "${_USER}" \
        DISPLAY=:0 \
        DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/${_UID}/bus \
        PATH=/usr/bin:${PATH} \
        XDG_DATA_DIRS="/usr/share/${XDG_CURRENT_DESKTOP}:/usr/share" \
        XDG_RUNTIME_DIR=/run/user/${_UID} \
        zenity --entry --hide-text --title="${1}" --text="${2}")
}

mkdir -p "${MOUNT}"

if /usr/sbin/cryptsetup isLuks ${BLKD}; then
    lsusb | grep -qi "Yubico" && YUBIKEY_PRESENT=true || YUBIKEY_PRESENT=false

    if [ -n "${_USER}" ] && [ -d "/run/user/${_UID}" ]; then
        if [ "${YUBIKEY_PRESENT}" = true ]; then
            zenity_ask_pass "YubiKey FIDO2 Request" "Enter FIDO2 PIN for encrypted disk (${UUID}):"
            if [ $? -ne 0 ]; then
                send_notification "Aborted" "Aborted from password dialog." "dialog-error"
                exit 1
            elif [ -n "${PASS}" ]; then
                send_notification "YubiKey Active" "PIN entered. Please touch your YubiKey to authenticate..." "dialog-information"
                echo "${PASS}" | /usr/sbin/cryptsetup --token-only open "${BLKD}" "${UUID}_luks"
            else
                send_notification "YubiKey Active" "Please touch your YubiKey to authenticate..." "dialog-information"
                /usr/sbin/cryptsetup open "${BLKD}" "${UUID}_luks"
            fi
        else
            zenity_ask_pass "LUKS Password Request" "Enter standard passphrase for disk (${UUID}):"
            if [ $? -ne 0 ]; then
                send_notification "Aborted" "Aborted from password dialog." "dialog-error"
                exit 1
            elif [ -n "${PASS}" ]; then
                echo "${PASS}" | /usr/sbin/cryptsetup open "${BLKD}" "${UUID}_luks"
            else
                send_notification "Aborted" "No passphrase was provided." "dialog-error"
                exit 1
            fi
        fi
    fi

    mount /dev/mapper/${UUID}_luks -orw "${MOUNT}"
    if [ $? -ne 0 ]; then
        send_notification "Backup failed" "Encrypted Disk ${UUID} could not be mounted!" "dialog-error"
        exit 1
    fi
else
    mount -U "${UUID}" -orw "${MOUNT}"
    if [ $? -ne 0 ]; then
        send_notification "Backup failed" "Disk ${UUID} could not be mounted!" "dialog-error"
        exit 1
    fi
fi

send_notification "Backup started" "Disk ${UUID} was plugged in, rsync'ing: ${SOURCE}..." "drive-harddisk"

rsync -aAXv --ignore-missing-args --delete "${SOURCE}" "${MOUNT}/$(basename "${SOURCE}")/" &> "${LOGFILE}"
RSYNC_STATUS=$?

umount "${MOUNT}"
rmdir "${MOUNT}"

if /usr/sbin/cryptsetup isLuks ${BLKD} ; then
    /usr/sbin/cryptsetup close ${UUID}_luks
fi

if [ ${RSYNC_STATUS} -eq 0 ]; then
    send_notification "Backup finished" "All files syncronized, Drive ${UUID} may be removed." "emblem-success"
    rm -f "${LOGFILE}"
else
    send_notification "Backup failed" "rsync failed with Error: ${RSYNC_STATUS} (see ${LOGFILE} for details)!" "dialog-error"
fi
