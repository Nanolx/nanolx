#!/bin/sh
set -e

case "${1}" in
    configure)
        if command -v update-icon-caches >/dev/null; then
            update-icon-caches /usr/share/icons/Tela-red-dark
        fi
    ;;

    abort-upgrade|abort-remove|abort-deconfigure)
        ;;

    *)
        echo "postinst called with unknown argument \`${1}'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
